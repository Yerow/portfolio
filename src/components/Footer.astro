---
const year = new Date().getFullYear();
---

<footer>
  <span>© {year} Yupa · Mohamed</span>
  <span class="footer-hint">Fait avec Astro · <kbd class="mod-key">Ctrl</kbd> <kbd>K</kbd> pour naviguer</span>
</footer>

<style>
  footer {
    padding: 28px var(--gutter);
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }

  @media (hover: none) {
    .footer-hint kbd {
      display: none;
    }
  }
</style>
