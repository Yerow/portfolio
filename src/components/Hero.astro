---
import { email } from "../data/projects";
---

<section class="hero">
  <div class="hero-inner">
    <p class="hero-label"><span class="accent">~/yupa</span> · étudiant ingénieur à CPE Lyon</p>

    <h1 class="hero-title" id="hero-title" aria-label="Mohamed, développeur web.">
      <span class="line" aria-hidden="true">Mohamed,</span>
      <span class="line accent" aria-hidden="true">développeur web.</span>
    </h1>

    <p class="hero-subtitle">
      Je conçois et je code des sites et des applis, de la maquette à la mise en prod. Derniers projets livrés&nbsp;: la plateforme
      de la SYL Cup pour la fédération de football de Singapour, et une campagne gamifiée pour Tropicana en Malaisie.
    </p>

    <div class="hero-cta">
      <a href="#projets" class="btn btn--filled">Voir les projets</a>
      <button type="button" class="btn btn--outlined" data-copy-email>
        <span data-copy-label>{email}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      </button>
    </div>
  </div>

  <dl class="hero-facts">
    <div><dt>Basé à</dt><dd>Lyon</dd></div>
    <div><dt>Diplôme</dt><dd>Ingé CPE, sept. 2026</dd></div>
    <div><dt>Stack</dt><dd>Next.js, Astro, Node</dd></div>
    <div><dt>Statut</dt><dd><span class="status-dot" aria-hidden="true"></span>Ouvert aux projets</dd></div>
  </dl>
</section>

<style>
  .hero {
    min-height: 92svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 64px;
    padding: 140px var(--gutter) 40px;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    margin-block: auto;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 6.6vw, 104px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
    cursor: default;
  }

  .line {
    display: block;
    white-space: nowrap;
  }

  .hero-subtitle {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 56ch;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn {
    padding: 13px 22px;
    font-weight: 600;
    border-radius: 8px;
    font-size: 15px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: transform 0.2s var(--ease), border-color 0.2s, background 0.2s;
  }

  .btn--filled {
    background: var(--accent);
    color: var(--on-accent);
    border: 1px solid var(--accent);
  }

  .btn--filled:hover {
    transform: translateY(-2px);
  }

  .btn--outlined {
    background: transparent;
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
  }

  .btn--outlined:hover {
    border-color: var(--accent);
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    padding-top: 20px;
    gap: 20px;
  }

  .hero-facts div {
    display: grid;
    gap: 4px;
  }

  .hero-facts dt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }

  .hero-facts dd {
    font-size: 15px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    to {
      box-shadow: 0 0 0 8px transparent;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 110px;
      min-height: auto;
    }

    .hero-title {
      font-size: clamp(34px, 10vw, 56px);
    }

    .line {
      white-space: normal;
    }

    .hero-subtitle {
      font-size: 16px;
    }

    .hero-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Titre qui se recompose : au chargement et au survol
  const title = document.getElementById("hero-title")!;
  const lines = [...title.querySelectorAll<HTMLElement>(".line")];
  const finals = lines.map((l) => l.textContent ?? "");
  const glyphs = "abcdefghijklmnopqrstuvwxyz<>/_#*";
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let running = false;

  function scramble() {
    if (running || reduce) return;
    running = true;
    const start = performance.now();
    const duration = 700;
    const frame = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      lines.forEach((line, li) => {
        const text = finals[li];
        line.textContent = [...text]
          .map((ch, i) => {
            if (ch === " " || ch === "," || ch === ".") return ch;
            return i / text.length < p ? ch : glyphs[(Math.random() * glyphs.length) | 0];
          })
          .join("");
      });
      if (p < 1) requestAnimationFrame(frame);
      else running = false;
    };
    requestAnimationFrame(frame);
  }

  scramble();
  title.addEventListener("mouseenter", scramble);
</script>
