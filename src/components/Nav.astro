---
const navItems = [
  { label: "Projets", href: "#projets" },
  { label: "À propos", href: "#propos" },
  { label: "Stack", href: "#competences" },
  { label: "Contact", href: "#contact" },
];
---

<nav class="nav">
  <a href="#" class="nav-logo" aria-label="Yupa, retour en haut">Yupa<span class="accent">.</span></a>

  <div class="nav-links" id="nav-links">
    {navItems.map((item) => <a href={item.href} class="nav-link">{item.label}</a>)}
  </div>

  <div class="nav-tools">
    <span class="nav-clock" title="Heure à Lyon">
      <span class="nav-dot" aria-hidden="true"></span>
      <span>Lyon <time id="lyon-time">--:--</time></span>
    </span>
    <button class="nav-btn nav-cmd" type="button" data-open-palette aria-label="Ouvrir la palette de commandes">
      <kbd class="mod-key">Ctrl</kbd><kbd>K</kbd>
    </button>
    <button class="nav-btn" type="button" id="theme-toggle" aria-label="Passer en mode sombre">
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    </button>
    <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 16px var(--gutter);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s;
  }

  .nav.scrolled {
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  .nav-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .nav-links {
    display: flex;
    gap: 28px;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-clock {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    margin-right: 4px;
    font-variant-numeric: tabular-nums;
  }

  .nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .nav-btn {
    height: 32px;
    min-width: 32px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .nav-btn:hover {
    border-color: var(--line-strong);
    color: var(--text-primary);
  }

  .nav-btn kbd {
    border: 0;
    padding: 0;
  }

  .icon-sun {
    display: none;
  }

  :global([data-theme-current="dark"]) .icon-sun {
    display: block;
  }

  :global([data-theme-current="dark"]) .icon-moon {
    display: none;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    z-index: 102;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    margin: 0 auto;
    background: var(--text-primary);
    transition: transform 0.3s var(--ease);
  }

  .nav-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .nav-clock {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .nav-cmd {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-links {
      position: fixed;
      inset: 0;
      z-index: 101;
      background: var(--bg);
      flex-direction: column;
      justify-content: center;
      padding: 0 var(--gutter);
      gap: 8px;
      transform: translateY(-100%);
      transition: transform 0.45s var(--ease);
    }

    .nav-links.open {
      transform: none;
    }

    .nav-link {
      font-family: var(--font-display);
      font-size: 40px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text-primary);
    }
  }
</style>

<script>
  import { currentTheme, toggleTheme } from "../scripts/site";

  const nav = document.querySelector(".nav")!;
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle")!;
  const links = document.getElementById("nav-links")!;
  const themeBtn = document.getElementById("theme-toggle")!;
  const time = document.getElementById("lyon-time")!;

  addEventListener("scroll", () => nav.classList.toggle("scrolled", scrollY > 30), { passive: true });

  const setMenu = (open: boolean) => {
    links.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };
  toggle.addEventListener("click", () => setMenu(!links.classList.contains("open")));
  links.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));

  // Thème
  const syncTheme = () => {
    const t = currentTheme();
    document.documentElement.dataset.themeCurrent = t;
    themeBtn.setAttribute("aria-label", t === "dark" ? "Passer en mode clair" : "Passer en mode sombre");
  };
  themeBtn.addEventListener("click", toggleTheme);
  addEventListener("themechange", syncTheme);
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", syncTheme);
  syncTheme();

  // Raccourci affiché : ⌘ sur Mac
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll(".mod-key").forEach((k) => (k.textContent = "⌘"));
  }

  // Heure de Lyon
  const fmt = new Intl.DateTimeFormat("fr-FR", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Paris" });
  const tick = () => (time.textContent = fmt.format(new Date()));
  tick();
  setInterval(tick, 20000);
</script>
