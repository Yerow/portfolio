---
import { email } from "../data/projects";

const links = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/mohamed-gueffaf-8104191b9/" },
  { label: "GitHub", href: "https://github.com/Yerow" },
];
---

<section id="contact" class="section-padding contact-section">
  <div class="section-label" data-reveal>contact</div>
  <h2 class="section-title" data-reveal>Une idée, un projet, un poste&nbsp;?</h2>
  <p class="contact-subtitle" data-reveal>
    Le plus simple, c'est par mail. Clique sur l'adresse pour la copier.
  </p>

  <button type="button" class="contact-email" data-copy-email data-reveal>
    <span data-copy-label>{email}</span>
    <span class="contact-email-hint" aria-hidden="true">copier</span>
  </button>

  <ul class="contact-links" data-reveal>
    {links.map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span aria-hidden="true">↗</span></a>
      </li>
    ))}
    <li><a href={`mailto:${email}`}>Ouvrir dans ma messagerie <span aria-hidden="true">↗</span></a></li>
  </ul>
</section>

<style>
  .contact-section {
    border-top: 1px solid var(--line);
  }

  .contact-subtitle {
    margin-top: 18px;
    font-size: 17px;
    color: var(--text-secondary);
    max-width: 52ch;
  }

  .contact-email {
    margin-top: 40px;
    display: inline-flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    max-width: 100%;
    background: none;
    border: 0;
    border-bottom: 2px solid var(--accent);
    padding: 0 0 8px;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 6vw, 72px);
    letter-spacing: -0.03em;
    color: var(--text-primary);
    text-align: left;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }

  .contact-email:hover {
    color: var(--accent);
  }

  .contact-email-hint {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text-secondary);
  }

  .contact-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 40px;
  }

  .contact-links a {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .contact-links a:hover {
    color: var(--text-primary);
  }
</style>
